# ==================================================================================
#  .gitignore for Categorization Pipeline
# ==================================================================================
#  Generic framework for batch LLM categorization (SENTIMENT, ESCALATION, etc.)
#  Organized by category for easy maintenance.
# ==================================================================================


### 1. Environments & Dependencies
# ----------------------------------------------------------------------------------
# Environment variables (keep template)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!env.template

# Virtual environments
.venv
venv/
env/
ENV/
env.bak/
venv.bak/
.python-version
__pypackages__/


### 2. Python - Compiled Files & Distribution
# ----------------------------------------------------------------------------------
# Byte-compiled files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec


### 3. Testing, Coverage & Caching
# ----------------------------------------------------------------------------------
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/


### 4. Type Checkers (mypy)
# ----------------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/


### 5. Jupyter & IPython
# ----------------------------------------------------------------------------------
.ipynb_checkpoints
profile_default/
ipython_config.py

# Keep Jupyter notebooks for documentation/testing (uncomment to ignore)
# *.ipynb


### 6. Operating System Files
# ----------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
ehthumbs.db
Thumbs.db
desktop.ini


### 7. IDEs & Code Editors
# ----------------------------------------------------------------------------------
# VSCode
.vscode/
*.code-workspace

# JetBrains (PyCharm, etc.)
.idea/

# Spyder
.spyderproject
.spyproject

# Vim
*.swp
*.swo
*~


### 8. Logs & Temporary Files
# ----------------------------------------------------------------------------------
logs/
*.log
*.tmp
*.temp
*.bak
*.backup
pip-log.txt
pip-delete-this-directory.txt
tmp/
temp/


### 9. Project-Specific Output Directories
# ----------------------------------------------------------------------------------
# Experiment directories (contains labeled data, batch files, metadata)
experiments/

# Reports (if you add report generation)
reports/

# Debug output
debug/


### 10. Data Files
# ----------------------------------------------------------------------------------
# Ignore data files (parquet, pickles, etc.)
*.parquet
*.pkl
*.pickle
*.csv
*.zip
*.tar.gz

# JSONL batch files (generated by pipeline)
*.jsonl

# Keep example/template data (uncomment if you have sample data)
# !data/sample.parquet
# !data/example.csv


### 11. Credentials & Secrets
# ----------------------------------------------------------------------------------
# Google Cloud credentials
*.json
!pyproject.json  # Keep pyproject.json if you have one
!package.json    # Keep package.json if you have one
!tsconfig.json   # Keep TypeScript config if you have one
gha-creds-*.json
credentials.json
service-account.json

# AWS credentials
.aws/


### 12. Ruff & Linting
# ----------------------------------------------------------------------------------
.ruff_cache/


### 13. Documentation (Generated)
# ----------------------------------------------------------------------------------
# Keep markdown docs in repo
# docs/

# LaTeX build artifacts
*.aux
*.fdb_latexmk
*.fls
*.synctex.gz
*.toc
*.out


### 14. Miscellaneous
# ----------------------------------------------------------------------------------
# OpenAI/Claude cache
.deepeval/
.claude/
.gemini/

# Batch processing artifacts
temp_artifacts/
artifacts/

# System configs that shouldn't be in repo
.config/


# ==================================================================================
#  Keep These Files (Explicitly NOT Ignored)
# ==================================================================================
# These are important files that should be version controlled:
#
# ✅ CLAUDE.md              - Project instructions for Claude Code
# ✅ README.md              - Project documentation
# ✅ env.template           - Environment variable template
# ✅ pyproject.toml         - Package configuration
# ✅ RUFF_SETUP.md          - Ruff configuration guide
# ✅ src/                   - All source code
# ✅ tests/                 - Test suite
# ✅ *.ipynb (optional)     - Jupyter notebooks for analysis
# ==================================================================================
